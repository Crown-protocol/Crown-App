# Crown-App chain config. Copy to .env.local and fill in as the backend ships.

# Public base URL of the deployment (used for OpenGraph/Twitter share-image URLs). Falls back to
# https://crown.tv. Set this to your real domain in production.
# NEXT_PUBLIC_SITE_URL=https://crown.tv
# Everything has a sane devnet default baked into lib/chain/config.ts — you only
# need this file to OVERRIDE ids or to light up the ICP features.
#
# The admin panel → "Launch readiness" mirrors this file live: every amber row
# there names the variable here that turns it green.

# ── Solana devnet (deployed today; defaults already point at these) ─────────
# NEXT_PUBLIC_CHAIN_ID=solana-devnet
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# WalletConnect (Reown AppKit) — powers the "WalletConnect" option in the connect modal. Free
# projectId at https://cloud.reown.com. Unset = that option is disabled; Phantom/Solflare unaffected.
# NEXT_PUBLIC_REOWN_PROJECT_ID=
# NEXT_PUBLIC_SPLITTER=DDSeyx684iU9agHbXExwS3NstLvQeLKZcJWcJFSh1VDA
# NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# NEXT_PUBLIC_FACTORY_TWO_OUTCOME=83f7ziVs5VeQ8xiDka8zczbfJT4WcxsXQ18cqWwmV5ur
# NEXT_PUBLIC_FACTORY_PAYOUT_TABLE=EzvxRLxLvPW6TdmVCQ2JBWiv37tCD6kSngNvS2z2D3ka
# NEXT_PUBLIC_FACTORY_STREAM=57MpCQ3TfAE66qDAnfkP9AX7LRqwd4CNX8uN6DaVwm3V
# NEXT_PUBLIC_FEE_WALLET=3it64t7KXNip1C1BRYNh8ygeKyujWnaQrPSj3hV9TWbE

# ── ICP resolvers (NOT deployed yet — games stay on the mock/synced layer until set) ──
# Ask the on-chain dev for the gateway host + canister principals, then uncomment.
# Each principal is an independent switch: set TASKS and only the task game goes
# on-chain (escrow birth + canister registration + verdict actions), the rest
# keep running exactly as today.
# NEXT_PUBLIC_IC_HOST=https://icp0.io
# NEXT_PUBLIC_CROWN_INDEX_PRINCIPAL=
# NEXT_PUBLIC_TASKS_PRINCIPAL=
# NEXT_PUBLIC_FUNDING_PRINCIPAL=
# NEXT_PUBLIC_AUCTION_PRINCIPAL=
# NEXT_PUBLIC_SUBSCRIPTION_PRINCIPAL=

# ── MAINNET cutover (F6 — when Crown-Core/Factory publish config/mainnet.toml) ──
# The launch is env-only: no code changes. Set ALL of these together from the
# backend repos' mainnet profiles, rebuild, done. Mixing networks is the one
# fatal misconfig — the chain id is part of every salt, verdict domain and
# signed message, so a wrong pair fails loudly, not silently.
# NEXT_PUBLIC_CHAIN_ID=solana-mainnet
# NEXT_PUBLIC_SOLANA_RPC=<mainnet rpc>
# NEXT_PUBLIC_SPLITTER=<Crown-Core config/mainnet.toml>
# NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# NEXT_PUBLIC_FACTORY_TWO_OUTCOME=<Crown-Factory deploy/mainnet.toml>
# NEXT_PUBLIC_FACTORY_PAYOUT_TABLE=<…>
# NEXT_PUBLIC_FACTORY_STREAM=<…>
# NEXT_PUBLIC_FEE_WALLET=<…>
# + the ICP principals of the mainnet-profile canisters

# ── Release knobs ───────────────────────────────────────────────────────────
# Fresh visitors see real chain data instead of the mock demo
# (.env.production already pins this for prod builds):
# NEXT_PUBLIC_DEFAULT_MODE=chain

# ── Database ────────────────────────────────────────────────────────────────
# Default: SQLite file at data/crown.db (daily backups in data/backups/).
# For serverless hosting point at a Turso/libsql server instead:
# LIBSQL_URL=libsql://<your-db>.turso.io
# LIBSQL_AUTH_TOKEN=
# Override the local DB directory (e.g. a mounted volume):
# CROWN_DB_DIR=/var/lib/crown

# ── Telegram (optional) ─────────────────────────────────────────────────────
# The notification bot runs as its own process (bot/README.md):
# TELEGRAM_BOT_TOKEN= + shared secret wiring per bot/.env.example

# Public address of the site (https://... in production, http://localhost:3000 locally).
# Controls the Secure flag on the session cookie.
CROWN_SITE_URL=http://localhost:3000
